{
  "name": "cinelog",
  "version": "1.0.0",
  "description": "<p align=\"center\">   <img src=\"static/icons/icon-512.png\" width=\"120\" height=\"120\" alt=\"CineLog Logo\" style=\"border-radius: 28px; box-shadow: 0 8px 24px rgba(0,0,0,0.35);\"> </p>",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build": "npm run build:app && npm run build:drive",
    "build:app": "esbuild static/js/main.js --bundle --minify --sourcemap --outfile=static/dist/app.min.js",
    "build:drive": "esbuild static/js/drive_sync.js --bundle --format=iife --minify --sourcemap --outfile=static/dist/drive_sync.min.js",
    "watch": "esbuild static/js/main.js --bundle --minify --sourcemap --outfile=static/dist/app.min.js --watch",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "python3 -m pytest tests/ -q",
    "test:e2e": "playwright test",
    "check:types": "python3 -m mypy && python3 -m pyflakes services routes scripts app.py run.py tests/",
    "check:frontend": "python3 scripts/check_frontend.py",
    "check:xss": "python3 scripts/check_xss.py",
    "check:data": "python3 scripts/check_data_sync.py",
    "check:version": "python3 scripts/sync_version.py check",
    "verify": "npm run test:unit && npm run check:types && npm run check:data && npm run check:frontend && npm run check:xss && npm run check:version && npm run test:e2e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavvel42/CineLog.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/pavvel42/CineLog/issues"
  },
  "homepage": "https://github.com/pavvel42/CineLog#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.28.2"
  }
}
