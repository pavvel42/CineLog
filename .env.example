# CineLog Backend Configuration
# Skopiuj ten plik do .env i uzupełnij swój klucz API.

# Klucz The Movie Database (TMDb) API (v3 auth)
# Darmowy klucz można wygenerować w 1 minutę na: https://www.themoviedb.org/settings/api
TMDB_API_KEY=twoj_klucz_tmdb_tutaj

# Port serwera Flask (opcjonalnie, domyślnie 5001)
# PORT=5001
