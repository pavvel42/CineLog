# CineLog Backend Configuration
# Skopiuj ten plik do .env i uzupełnij swój klucz API.

# Klucz The Movie Database (TMDb) API (v3 auth)
# Darmowy klucz można wygenerować w 1 minutę na: https://www.themoviedb.org/settings/api
TMDB_API_KEY=twoj_klucz_tmdb_tutaj

# Klucz OMDb (plakaty i daty premier jako fallback) - darmowy, 8 znaków:
# https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=twoj_klucz_omdb_tutaj

# Historyczny alias OMDb - czytany TYLKO wtedy, gdy OMDB_API_KEY jest puste i wartość
# ma 8 znaków (długość klucza OMDb). Klucz TMDb w tym miejscu jest ignorowany z ostrzeżeniem
# w logu — myląca nazwa, więc najbezpieczniej po prostu nie ustawiać tej zmiennej.
# IMDB_API_KEY=twoj_klucz_omdb_tutaj

# Port serwera Flask (opcjonalnie, domyślnie 5001)
# PORT=5001
